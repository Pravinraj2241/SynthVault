# ---------------------------------------------------------------------------
# SynthVault frontend environment (copy to .env.local and adjust)
# ---------------------------------------------------------------------------

# Base URL of the SynthVault Spring Boot API.
# If unset, the frontend falls back to http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Because the backend does not declare a CORS configuration, a browser page on
# http://localhost:5173 cannot call http://localhost:8080 directly. For local
# development you can route the API through the Vite dev proxy instead by using
# a relative base URL (the proxy target defaults to http://localhost:8080):
#
# VITE_API_BASE_URL=/api
# VITE_API_PROXY_TARGET=http://localhost:8080
